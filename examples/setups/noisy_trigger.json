{
    "format": "SIGNAL LAB PRO setup", "version": 1,
    "description": "1 kHz sine buried in 0.2 V rms white noise. NORMAL trigger with noise reject (0.5 div hysteresis) keeps the display stable; long persistence shows the noise band; 16x FFT averaging lowers the variance of the noise floor.",
    "channels": [
        { "enabled": true, "voltsPerDiv": 0.5, "position": 0, "input": 0 },
        { "enabled": false }, { "enabled": false }, { "enabled": false }
